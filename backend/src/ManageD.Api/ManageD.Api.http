@ManageD_Api_HostAddress = http://localhost:5093
@userId = 00000000-0000-0000-0000-000000000000
@workspaceId = 00000000-0000-0000-0000-000000000000
@assetId = 00000000-0000-0000-0000-000000000000

### Create user
POST {{ManageD_Api_HostAddress}}/api/users
Content-Type: application/json

{
  "displayName": "Alice"
}

### Get user
GET {{ManageD_Api_HostAddress}}/api/users/{{userId}}

### Create workspace
POST {{ManageD_Api_HostAddress}}/api/workspaces
Content-Type: application/json

{
  "name": "My workspace",
  "creatorUserId": "{{userId}}"
}

### List a user's workspaces
GET {{ManageD_Api_HostAddress}}/api/workspaces?userId={{userId}}

### Add member to workspace
POST {{ManageD_Api_HostAddress}}/api/workspaces/{{workspaceId}}/members
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### Delete workspace
DELETE {{ManageD_Api_HostAddress}}/api/workspaces/{{workspaceId}}

# Assets are kept in memory for now, so they disappear when the backend restarts
# and any @assetId copied before the restart returns 404.

### Create asset (templateType omitted, defaults to Todo)
POST {{ManageD_Api_HostAddress}}/api/assets
Content-Type: application/json

{
  "title": "Groceries",
  "workspaceId": "{{workspaceId}}"
}

### Create asset with explicit template type
POST {{ManageD_Api_HostAddress}}/api/assets
Content-Type: application/json

{
  "title": "Sprint tasks",
  "workspaceId": "{{workspaceId}}",
  "templateType": "Todo"
}

### Create asset with unknown template type (expect 400)
POST {{ManageD_Api_HostAddress}}/api/assets
Content-Type: application/json

{
  "title": "Board",
  "workspaceId": "{{workspaceId}}",
  "templateType": "Kanban"
}

### Create asset with empty title (expect 400)
POST {{ManageD_Api_HostAddress}}/api/assets
Content-Type: application/json

{
  "title": "",
  "workspaceId": "{{workspaceId}}"
}

### Create asset in unknown workspace (expect 404)
POST {{ManageD_Api_HostAddress}}/api/assets
Content-Type: application/json

{
  "title": "Groceries",
  "workspaceId": "00000000-0000-0000-0000-000000000000"
}

### List assets in a workspace
GET {{ManageD_Api_HostAddress}}/api/assets?workspaceId={{workspaceId}}

### Get asset
GET {{ManageD_Api_HostAddress}}/api/assets/{{assetId}}

### Delete asset
DELETE {{ManageD_Api_HostAddress}}/api/assets/{{assetId}}
